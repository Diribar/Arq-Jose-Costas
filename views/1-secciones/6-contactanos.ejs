<form action="/contactanos" method="POST">
	<section id="inputs" class="flexCol">
		<h2><%= n.titulo_seccion %></h2>

		<!-- Nombre -->
		<div class="relative flexCol">
			<input class="input" type="text" name="nombre" placeholder="Nombre"
				value="<%= locals.datos ? datos.nombre : null %>"
			>
			<i class="fas fa-times-circle ocultar"></i>
		</div>

		<!-- E-Mail -->
		<div class="relative flexCol">
			<input class="input" type="text" name="mail" placeholder="E-Mail"
				value="<%= locals.datos ? datos.mail : null %>"
			>
			<i class="fas fa-times-circle ocultar"></i>
		</div>

		<!-- Teléfono -->
		<div class="relative flexCol">
			<input class="input" type="text" name="telefono" placeholder="Teléfono (opcional)"
				value="<%= locals.datos ? datos.telefono : null %>"
			>
			<i class="fas fa-times-circle ocultar"></i>
		</div>

		<!-- Comentario -->
		<div class="relative flexCol">
			<textarea class="input" name="comentario" rows="6" placeholder="Comentario" autocomplete="off"><%= locals.datos ? datos.comentario : null %></textarea>
			<i class="fas fa-times-circle ocultar"></i>
		</div>
	</section>

	<!-- Columna derecha -->
	<section id="texto" class="flexCol">
		<!-- Datos de José -->
		<div class="flexCol">
			<h3><%= contactanos.find(n => n.grupo == 1).contenido %></h3>
			<% registros = contactanos.filter(m => (m.grupo == 2)) %>
			<% for (registro of registros) { %>
				<p><%= registro.contenido %></p>
				<%- registro == registros[0] ? '<br>' : '' %>
			<% } %>
		</div>

		<!-- Submit -->
		<div id="submit">
			<p id="suma1" class="noSeleccionable"><%= suma1 %></p>
			<p class="noSeleccionable">+</p>
			<p id="suma2" class="noSeleccionable"><%= suma2 %></p>
			<p class="noSeleccionable">=</p>
			<div class="relative flexCol">
				<input id="suma" class="input" type="text" name="suma"
					value="<%= locals.datos ? "X" : null %>"
					autocomplete="off"
				>
				<i id="errorSuma" class="fas fa-times-circle ocultar"></i>
			</div>
			<button style="background-color:<%= n.color_letras.codigo %>" type="submit">Enviar</button>
		</div>
	</section>
</form>
<section id="background" class="ocultar"></section>
<section id="envioExitoso" class="ocultar cartel flexCol" style="background-color:<%= n.color_letras.codigo %>">
	<p style="color:<%= n.color_fondo.codigo %>">¡Su mensaje fue enviado correctamente!</p>
	<img src="/imagenes/varias/ok.png">
	<button style="background-color:<%= n.color_fondo.codigo %>; color:<%= n.color_letras.codigo %>">Entendido</button>
</section>
<section id="envioFallido" class="ocultar cartel flexCol" style="background-color:<%= n.color_letras.codigo %>">
	<p style="color:<%= n.color_fondo.codigo %>">Hubo un error interno que impidió enviar su mensaje</p>
	<img src="/imagenes/varias/Advertencia.png">
	<button style="background-color:<%= n.color_fondo.codigo %>; color:<%= n.color_letras.codigo %>">Entendido</button>
</section>
